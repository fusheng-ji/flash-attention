  "title": "[CuTe, SM100] Apply L2 swizzling to LPT CLC scheduling",
  "user": {
    "login": "XYX-XYX-XYX",
    "id": 105575086,
    "node_id": "U_kgDOBkryrg",
    "avatar_url": "https://avatars.githubusercontent.com/u/105575086?v=4",
